        },
        {
          "id": "panel-technical-heading",
          "type": "text",
          "x": 23.4375,
          "y": 2.3438,
          "width": 712.5,
          "height": 53.9062,
          "text": "Input, model and output",
          "font_family": "Arial",
          "font_size": 41.0156,
          "font_weight": 700,
          "font_style": "normal",
          "color": "#ffffff",
          "align": "left",
          "line_height": 1.16,
          "source_ids": [],
          "typography_role": "section_heading",
          "near_background": "#ffffff"
        },
        {
          "id": "io-body",
          "type": "text",
          "x": 23.4375,
          "y": 72.6562,
          "width": 712.5,
          "height": 173.4375,
          "text": "Input: a paper PDF, its figures and tables, and design constraints. A fixed LLM or MLLM works inside the harness. The inner loop outputs an editable artifact and its execution trajectory. Across tasks, the meta-harness outputs an improved DesignHarness. Model weights remain unchanged.",
          "font_family": "Arial",
          "font_size": 26.7188,
          "font_weight": 400,
          "font_style": "normal",
          "color": "#080c10",
          "align": "left",
          "line_height": 1.075,
          "source_ids": [
            "text-p005-009",
            "text-p005-011"
          ],
          "typography_role": "body",
          "near_background": "#ffffff",
          "emphasis": [
            {
              "text": "Input:",
              "font_weight": 700
            }
          ]
        }
      ]
    },
