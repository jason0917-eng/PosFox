        },
        {
          "id": "method-inner-first",
          "type": "text",
          "x": 340.4297,
          "y": 72.6562,
          "width": 395.5078,
          "height": 31.7438,
          "text": "The designer writes or revises",
          "font_family": "Arial",
          "font_size": 26.25,
          "font_weight": 400,
          "font_style": "normal",
          "color": "#080c10",
          "align": "left",
          "line_height": 1.12,
          "source_ids": [
            "text-p005-011",
            "text-p008-027",
            "text-p008-029",
            "text-p008-030"
          ],
          "typography_role": "body",
          "near_background": "#ffffff"
        },
        {
          "id": "method-inner-body",
          "type": "text",
          "x": 79.6875,
          "y": 102.0562,
          "width": 656.25,
          "height": 119.9438,
          "text": "the current artifact. A rule validator checks layout and source integrity, while a visual critic reviews the rendered design. Their feedback guides localized revision. Within this loop, the harness stays fixed.",
          "font_family": "Arial",
          "font_size": 26.25,
          "font_weight": 400,
          "font_style": "normal",
          "color": "#080c10",
          "align": "left",
          "line_height": 1.12,
          "source_ids": [
