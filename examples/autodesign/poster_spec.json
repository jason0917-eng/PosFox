          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 324 25\"><defs><linearGradient id=\"panel-motivation-paint\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#1f3b62\"/><stop offset=\"1\" stop-color=\"#304f6f\"/></linearGradient></defs><rect x=\"0\" y=\"0\" width=\"324\" height=\"25\" rx=\"6\" fill=\"url(#panel-motivation-paint)\"/></svg>",
