        },
        {
          "id": "benchmark-body",
          "type": "text",
          "x": 23.4375,
          "y": 75.0,
          "width": 712.5,
          "height": 215.625,
          "text": "The Main Track contains 100 papers across five disciplines. PosterBench-mini is a shared 10-paper subset for controlled comparisons. The frozen external benchmark is separate from the evaluator used during harness optimization. Seven weighted dimensions assess source truth, scientific communication and rendered usability. Severe failures impose score ceilings.",
          "font_family": "Arial",
          "font_size": 27.6562,
          "font_weight": 400,
          "font_style": "normal",
          "color": "#080c10",
          "align": "left",
          "line_height": 1.1,
