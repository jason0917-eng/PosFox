        {
          "id": "panel-motivation-heading",
          "type": "text",
          "x": 23.4375,
          "y": 2.3438,
          "width": 712.5,
          "height": 53.9062,
          "text": "Why optimize the harness?",
          "font_family": "Arial",
          "font_size": 41.0156,
          "font_weight": 700,
          "font_style": "normal",
          "color": "#ffffff",
          "align": "left",
          "line_height": 1.16,
          "source_ids": [],
          "typography_role": "section_heading",
          "near_background": "#ffffff"
        },
        {
          "id": "motivation-body",
          "type": "text",
          "x": 23.4375,
          "y": 77.3438,
          "width": 712.5,
          "height": 232.0312,
          "text": "Scientific design takes more than a single generation. An agent must understand the paper, select evidence, write layout code and repair the rendered result. Static workflows repeat the same failures. AutoDesign turns the surrounding harness into an optimization target, using human-annotated reference artifacts and optional natural-language guidance to ground design preferences.",
          "font_family": "Arial",
          "font_size": 27.4219,
          "font_weight": 400,
          "font_style": "normal",
          "color": "#080c10",
          "align": "left",
          "line_height": 1.16,
          "source_ids": [
            "text-p003-074"
          ],
          "typography_role": "body",
          "near_background": "#ffffff"
        }
      ]
    },
