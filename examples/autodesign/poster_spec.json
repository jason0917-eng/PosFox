          "y": 2.3438,
          "width": 712.5,
          "height": 53.9062,
          "text": "How PosterBench judges quality",
          "font_family": "Arial",
          "font_size": 41.0156,
          "font_weight": 700,
          "font_style": "normal",
          "color": "#ffffff",
          "align": "left",
          "line_height": 1.16,
          "source_ids": [],
